<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" styleClass="root" stylesheets="@../../css/main.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AdminController">

    <top>
        <HBox styleClass="navbar" spacing="20" alignment="CENTER_LEFT">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
            <Label text="⚙ Hệ thống Quản trị (Admin)" styleClass="navbar-brand"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Đăng xuất" styleClass="nav-btn" onAction="#handleLogout"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-padding: 20;">

            <Tab text="Kiểm duyệt Sản phẩm">
                <VBox spacing="14" styleClass="glass-panel">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                    <TableView fx:id="itemTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colItemName" text="Tên sản phẩm" prefWidth="250"/>
                            <TableColumn fx:id="colItemCategory" text="Danh mục" prefWidth="150"/>
                            <TableColumn fx:id="colItemPrice" text="Giá khởi điểm" prefWidth="150"/>
                            <TableColumn fx:id="colItemStatus" text="Trạng thái" prefWidth="120"/>
                        </columns>
                    </TableView>

                    <HBox spacing="12">
                        <Button text="Phê duyệt (Approve)" styleClass="button-signin" onAction="#handleApproveItem"/>
                        <Button text="Từ chối (Reject)" styleClass="button-outline" onAction="#handleRejectItem"/>
                    </HBox>
                    <Label fx:id="itemMessageLabel" text="" styleClass="label"/>
                </VBox>
            </Tab>

            <Tab text="Quản lý Người dùng">
                <VBox spacing="14" styleClass="glass-panel">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                    <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colUsername" text="Tên đăng nhập" prefWidth="200"/>
                            <TableColumn fx:id="colEmail" text="Email" prefWidth="250"/>
                            <TableColumn fx:id="colRole" text="Vai trò" prefWidth="150"/>
                        </columns>
                    </TableView>

                    <HBox spacing="12">
                        <Button text="Khóa tài khoản (Ban)" styleClass="button-outline" onAction="#handleBanUser" style="-fx-border-color: #ff6b6b; -fx-text-fill: #ff6b6b;"/>
                    </HBox>
                    <Label fx:id="userMessageLabel" text="" styleClass="label"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>