<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" styleClass="root" stylesheets="@../../css/main.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="navbar">
            <padding><Insets bottom="12" left="20" right="20" top="12" /></padding>
            <Label styleClass="navbar-brand" text="HỆ THỐNG ĐẤU GIÁ" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="220" spacing="12" styleClass="glass-panel">
            <padding><Insets bottom="20" left="15" right="15" top="20" /></padding>

            <Label style="-fx-font-size: 16px;" styleClass="label" text="MENU CHÍNH" />
            <Separator />

            <Button maxWidth="Infinity" styleClass="button-outline" text="Trang chủ Đấu giá" />
            <Button maxWidth="Infinity" styleClass="button-outline" text="Sản phẩm của tôi" />
            <Button maxWidth="Infinity" styleClass="button-outline" text="Trang Quản trị" />

            <Region VBox.vgrow="ALWAYS" />

            <Separator />
            <Button maxWidth="Infinity" style="-fx-background-color: #ff6b6b; -fx-border-color: #ff6b6b;" styleClass="button-signin" text="Đăng xuất" />
        </VBox>
    </left>

    <center>
        <StackPane style="-fx-padding: 20;">
            <Label style="-fx-text-fill: white; -fx-font-size: 24px;" styleClass="title-main" />
        </StackPane>
    </center>

</BorderPane>
