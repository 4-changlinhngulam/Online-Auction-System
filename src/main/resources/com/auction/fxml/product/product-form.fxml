<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane prefHeight="750.0" prefWidth="900.0"
            styleClass="root"
            stylesheets="@../../css/main.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.ProductFormController">

    <top>
        <HBox styleClass="navbar" spacing="20" alignment="CENTER_LEFT">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
            <Button text="← Quay lại" styleClass="nav-btn" onAction="#handleBack"/>
            <Label text="Thêm sản phẩm" styleClass="navbar-brand"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox alignment="CENTER" spacing="14" styleClass="glass-panel"
                      style="-fx-margin: 40px;">
                    <padding><Insets top="30" right="60" bottom="30" left="60"/></padding>

                    <Label text="THÔNG TIN SẢN PHẨM" styleClass="title-main"
                           alignment="CENTER" maxWidth="Infinity"/>

                    <Label text="ẢNH MINH HỌA" styleClass="label" maxWidth="Infinity"/>
                    <VBox spacing="10" alignment="CENTER" style="-fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-padding: 15;">
                        <StackPane prefHeight="160" prefWidth="240" style="-fx-background-color: #f9f9f9; -fx-background-radius: 4;">
                            <ImageView fx:id="productImageView" fitHeight="150" fitWidth="230" preserveRatio="true"/>
                            <Label fx:id="imagePlaceholderLabel" text="🖼️ Chưa chọn ảnh" style="-fx-text-fill: #999; -fx-font-size: 14px;"/>
                        </StackPane>
                        <HBox spacing="10" alignment="CENTER">
                            <Button text="Chọn ảnh..." styleClass="button-outline" onAction="#handleChooseImage"/>
                            <Label fx:id="imagePathLabel" text="Chưa có tệp nào" style="-fx-text-fill: #666; -fx-font-style: italic;" maxWidth="200" textOverrun="LEADING_ELLIPSIS"/>
                        </HBox>
                    </VBox>
                    <Label text="TÊN SẢN PHẨM" styleClass="label" maxWidth="Infinity"/>
                    <TextField fx:id="nameField"
                               promptText="Nhập tên sản phẩm"
                               styleClass="input-field" maxWidth="Infinity"/>

                    <Label text="MÔ TẢ" styleClass="label" maxWidth="Infinity"/>
                    <TextArea fx:id="descField"
                              promptText="Mô tả sản phẩm..."
                              prefHeight="100"
                              styleClass="input-field"
                              maxWidth="Infinity"/>

                    <Label text="DANH MỤC" styleClass="label" maxWidth="Infinity"/>
                    <ComboBox fx:id="categoryCombo"
                              maxWidth="Infinity"
                              styleClass="input-field"/>

                    <Label text="GIÁ KHỞI ĐIỂM (VND)" styleClass="label"
                           maxWidth="Infinity"/>
                    <TextField fx:id="priceField"
                               promptText="Nhập giá khởi điểm"
                               styleClass="input-field" maxWidth="Infinity"/>

                    <Label text="THỜI GIAN BẮT ĐẦU" styleClass="label" maxWidth="Infinity"/>
                    <HBox spacing="10" maxWidth="Infinity">
                        <DatePicker fx:id="startDatePicker"
                                    promptText="Chọn ngày (DD/MM/YYYY)"
                                    styleClass="input-field" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <TextField fx:id="startTimeField"
                                   promptText="Giờ (HH:mm)"
                                   prefWidth="120"
                                   styleClass="input-field"/>
                    </HBox>

                    <Label text="THỜI GIAN KẾT THÚC" styleClass="label" maxWidth="Infinity"/>
                    <HBox spacing="10" maxWidth="Infinity">
                        <DatePicker fx:id="endDatePicker"
                                    promptText="Chọn ngày (DD/MM/YYYY)"
                                    styleClass="input-field" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <TextField fx:id="endTimeField"
                                   promptText="Giờ (HH:mm)"
                                   prefWidth="120"
                                   styleClass="input-field"/>
                    </HBox>

                    <Region prefHeight="10"/>

                    <Button text="LƯU SẢN PHẨM"
                            styleClass="button-signin"
                            onAction="#handleSave"
                            maxWidth="Infinity"/>

                    <Button text="HỦY"
                            styleClass="button-outline"
                            onAction="#handleBack"
                            maxWidth="Infinity"/>

                    <Label fx:id="errorLabel" text=""
                           alignment="CENTER" maxWidth="Infinity"
                           style="-fx-text-fill: #ff6b6b;"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>